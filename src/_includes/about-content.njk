{% set about = aboutContent[aboutLocale or 'en'] %}

  <!-- CONTENT -->
  <main id="main-content" class="relative z-10 pt-28 pb-20 px-4">
    <div class="max-w-2xl mx-auto">

      <!-- Header -->
      <div class="text-center mb-14">
        <h1 class="text-4xl sm:text-5xl font-black mb-3 text-[#4A3728] dark:text-[#F0E6D8]">{{ about.heading }} <span class="font-black">Tofu<span class="text-[#6BBF59]">Pass</span></span></h1>
        <p class="text-[#8B7355] dark:text-[#B8A890] text-base max-w-md mx-auto">{{ about.tagline }}</p>
      </div>

      {% for section in about.sections %}
        <section class="faq-section" x-data="{open: null}">
          <div class="faq-section-label {{ section.labelClass }}">{{ section.label }}</div>

          {% for item in section.items %}
            <div class="faq-item">
              <button class="faq-trigger" id="faq-{{ section.labelClass }}-{{ loop.index }}" @click="open = open === {{ loop.index }} ? null : {{ loop.index }}" :aria-expanded="open === {{ loop.index }} ? 'true' : 'false'" aria-controls="faq-panel-{{ section.labelClass }}-{{ loop.index }}">
                <span>{{ item.question }}</span>
                <span class="faq-icon" :class="open === {{ loop.index }} ? 'rotate-45' : ''">+</span>
              </button>
              <div class="faq-answer" id="faq-panel-{{ section.labelClass }}-{{ loop.index }}" role="region" aria-labelledby="faq-{{ section.labelClass }}-{{ loop.index }}" x-show="open === {{ loop.index }}" x-cloak x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0 -translate-y-2" x-transition:enter-end="opacity-100 translate-y-0">
                {% for paragraph in item.answer %}
                  <p{% if not loop.first %} class="mt-3"{% endif %}>{{ paragraph | safe }}</p>
                {% endfor %}
              </div>
            </div>
          {% endfor %}
        </section>

        {% if section.dividerColor %}
          <!-- Divider -->
          <div class="faq-divider" aria-hidden="true">
            <svg class="w-36 h-3 {{ section.dividerColor }}" viewBox="0 0 150 12" fill="none">
              <path d="M0 6 C 18 0, 37 12, 56 6 S 93 0, 112 6 S 131 12, 150 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </div>
        {% endif %}
      {% endfor %}

    </div>
  </main>

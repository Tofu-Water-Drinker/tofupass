<html lang="{{ lang | default(m.lang) }}" dir="{{ m.dir }}">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ title }}</title>
  {% if description %}<meta name="description" content="{{ description }}" />{% endif %}
  <meta property="og:title" content="{{ title }}" />
  {% if description %}<meta property="og:description" content="{{ description }}" />{% endif %}
  <meta property="og:site_name" content="TofuPass" />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="{{ title }}" />
  {% if description %}<meta name="twitter:description" content="{{ description }}" />{% endif %}
  {# TODO(pwa): TofuPass does not currently ship a manifest or service worker. Add both before describing the web site as installable. #}
  {% if noindex %}<meta name="robots" content="noindex, nofollow" />{% endif %}
  <link rel="icon" href="/favicon.ico" />
  <script>(function(){var t=localStorage.getItem('theme');if(t==='dark'||(!t&&matchMedia('(prefers-color-scheme:dark)').matches))document.documentElement.classList.add('dark');})()</script>
  {% if extraFonts %}<link rel="preconnect" href="https://fonts.bunny.net" crossorigin />
  {% endif %}{% for font in extraFonts %}<link rel="stylesheet" href="{{ font }}" />
  {% endfor %}
  {% for script in headScripts %}<script defer src="{{ script }}"></script>
  {% endfor %}
  <link rel="stylesheet" href="/assets/css/tailwind.css" />
  <link rel="stylesheet" href="/assets/css/base.css" />
  {% for css in extraCss %}<link rel="stylesheet" href="{{ css }}" />
  {% endfor %}
</head>
<body class="overflow-x-hidden">
  <a class="skip-link" href="#main-content">{{ skipLabel }}</a>

  {% if backgroundDecor == "leaves" %}
  <div class="bg-deco">
    <div class="bg-leaf bg-leaf-1"></div>
    <div class="bg-leaf bg-leaf-2"></div>
    <div class="bg-leaf bg-leaf-3"></div>
    <div class="bg-leaf bg-leaf-4"></div>
    <div class="bg-leaf bg-leaf-5"></div>
    <div class="bg-dot bg-dot-1"></div>
    <div class="bg-dot bg-dot-2"></div>
    <div class="bg-dot bg-dot-3"></div>
    <div class="bg-dot bg-dot-4"></div>
    <div class="bg-dot bg-dot-5"></div>
  </div>
  {% elif backgroundDecor == "blobs" %}
  <div class="blob-bg">
    <div class="blob blob-1"></div>
    <div class="blob blob-2"></div>
    <div class="blob blob-3"></div>
    <div class="blob blob-4"></div>
    <div class="blob blob-5"></div>
    <div class="splat splat-1"></div>
    <div class="splat splat-2"></div>
    <div class="splat splat-3"></div>
    <div class="splat splat-4"></div>
    <div class="splat splat-5"></div>
    <div class="splat splat-6"></div>
  </div>
  {% endif %}

  <header class="nav-blur fixed top-0 left-0 right-0 z-50" data-nav-root>
    <nav class="nav-shell max-w-6xl mx-auto px-4 sm:px-6 flex items-center justify-between h-16" aria-label="{{ primaryNavLabel }}">
      <div class="flex items-center gap-3">
        <div class="wordmark-wrap">
          <a href="{{ homeHref | default(m.prefix + '/') }}" class="flex items-center group" aria-label="{{ homeAriaLabel | default(m.homeAria) }}">
            <img width="512" height="512" src="/tofu.webp" alt="" class="w-7 h-7 mr-2" aria-hidden="true" style="filter: drop-shadow(0 2px 4px rgba(107,191,89,0.2));" />
            <span class="font-black text-xl tracking-tight text-[#4A3728] dark:text-[#F0E6D8]">Tofu<span class="text-[#6BBF59] dark:text-[#7DD668]">Pass</span></span>
          </a>
          {% if showAnnouncement %}
          <div class="announcement-note" data-announcement role="status" aria-live="polite">
            <img width="500" height="500" src="/MisoUN.webp" alt="" class="announcement-mascot" aria-hidden="true" />
            <div class="announcement-copy">
              <span class="announcement-kicker">{{ m.announceTitle }}</span>
              <p>{{ m.announceBody }}</p>
            </div>
            <button type="button" class="announcement-close" data-announcement-close aria-label="{{ m.announceDismiss }}">&times;</button>
          </div>
          {% endif %}
        </div>
      </div>
      <div class="flex items-center gap-2">
        <div class="nav-links flex items-center gap-1 sm:gap-2" data-nav-menu>
          {% set primaryNav = navItems | default(localizedNav if isLocalized else nav) %}
          {% for item in primaryNav %}
            {% if item.key == pageKey %}
              <a href="{{ item.href }}" class="px-3 py-2 rounded-lg text-[#4A3728] dark:text-[#F0E6D8] font-bold text-sm bg-[#6BBF59]/10 dark:bg-[#7DD668]/15 border-2 border-[#6BBF59]/20 dark:border-[#7DD668]/25">{{ item.label }}</a>
            {% else %}
              <a href="{{ item.href }}" class="px-3 py-2 rounded-lg text-[#8B7355] dark:text-[#B8A890] hover:text-[#4A3728] dark:hover:text-[#F0E6D8] font-semibold text-sm hover:bg-[#6BBF59]/5 dark:hover:bg-[#7DD668]/10 transition-all">{{ item.label }}</a>
            {% endif %}
          {% endfor %}
        </div>
        <button type="button" class="theme-toggle" data-theme-toggle aria-label="{{ themeToggleLabel | default(m.theme) }}" title="{{ themeToggleLabel | default(m.theme) }}">
          <svg class="theme-icon-moon" viewBox="0 0 24 24"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
          <svg class="theme-icon-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
        </button>
        <div class="language-switcher" data-language-switcher>
          <label class="sr-only" for="languageSelect">{{ m.label }}</label>
          <button type="button" class="language-button" data-language-button aria-haspopup="listbox" aria-expanded="false" aria-label="{{ m.label }}">
            <span class="language-globe" aria-hidden="true">
              <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18"></path><path d="M12 3a13.8 13.8 0 0 1 0 18"></path><path d="M12 3a13.8 13.8 0 0 0 0 18"></path></svg>
            </span>
            <span class="language-current" data-language-current aria-hidden="true">EN</span>
            <span class="language-caret" aria-hidden="true"></span>
          </button>
          <select id="languageSelect" class="language-select" data-language-select aria-label="{{ m.label }}" tabindex="-1" aria-hidden="true">
            <option value="en"{% if currentLang == 'en' %} selected{% endif %}>English</option>
            <option value="es"{% if currentLang == 'es' %} selected{% endif %}>Spanish</option>
            <option value="pt"{% if currentLang == 'pt' %} selected{% endif %}>Portuguese</option>
            <option value="fr"{% if currentLang == 'fr' %} selected{% endif %}>French</option>
            <option value="de"{% if currentLang == 'de' %} selected{% endif %}>German</option>
            <option value="ja"{% if currentLang == 'ja' %} selected{% endif %}>Japanese</option>
            <option value="zh-cn"{% if currentLang == 'zh-cn' %} selected{% endif %}>Simplified Chinese</option>
            <option value="ar"{% if currentLang == 'ar' %} selected{% endif %}>Arabic</option>
            <option value="id"{% if currentLang == 'id' %} selected{% endif %}>Indonesian</option>
            <option value="hi"{% if currentLang == 'hi' %} selected{% endif %}>Hindi</option>
            <option value="ru"{% if currentLang == 'ru' %} selected{% endif %}>Russian</option>
          </select>
          <div class="language-menu" data-language-menu role="listbox" aria-label="{{ m.label }}" hidden>
            <button type="button" class="language-option" data-language-option data-language-code="en" role="option" aria-label="English" aria-selected="{% if currentLang == 'en' %}true{% else %}false{% endif %}">
              <span class="language-option-code" aria-hidden="true">EN</span><span class="language-option-name">English</span>
            </button>
            <button type="button" class="language-option" data-language-option data-language-code="es" role="option" aria-label="Spanish" aria-selected="{% if currentLang == 'es' %}true{% else %}false{% endif %}">
              <span class="language-option-code" aria-hidden="true">ES</span><span class="language-option-name">Español</span>
            </button>
            <button type="button" class="language-option" data-language-option data-language-code="pt" role="option" aria-label="Portuguese" aria-selected="{% if currentLang == 'pt' %}true{% else %}false{% endif %}">
              <span class="language-option-code" aria-hidden="true">PT</span><span class="language-option-name">Português</span>
            </button>
            <button type="button" class="language-option" data-language-option data-language-code="fr" role="option" aria-label="French" aria-selected="{% if currentLang == 'fr' %}true{% else %}false{% endif %}">
              <span class="language-option-code" aria-hidden="true">FR</span><span class="language-option-name">Français</span>
            </button>
            <button type="button" class="language-option" data-language-option data-language-code="de" role="option" aria-label="German" aria-selected="{% if currentLang == 'de' %}true{% else %}false{% endif %}">
              <span class="language-option-code" aria-hidden="true">DE</span><span class="language-option-name">Deutsch</span>
            </button>
            <button type="button" class="language-option" data-language-option data-language-code="ja" role="option" aria-label="Japanese" aria-selected="{% if currentLang == 'ja' %}true{% else %}false{% endif %}">
              <span class="language-option-code" aria-hidden="true">JA</span><span class="language-option-name">日本語</span>
            </button>
            <button type="button" class="language-option" data-language-option data-language-code="zh-cn" role="option" aria-label="Simplified Chinese" aria-selected="{% if currentLang == 'zh-cn' %}true{% else %}false{% endif %}">
              <span class="language-option-code" aria-hidden="true">ZH</span><span class="language-option-name">简体中文</span>
            </button>
            <button type="button" class="language-option" data-language-option data-language-code="ar" role="option" aria-label="Arabic" aria-selected="{% if currentLang == 'ar' %}true{% else %}false{% endif %}">
              <span class="language-option-code" aria-hidden="true">AR</span><span class="language-option-name">العربية</span>
            </button>
            <button type="button" class="language-option" data-language-option data-language-code="id" role="option" aria-label="Indonesian" aria-selected="{% if currentLang == 'id' %}true{% else %}false{% endif %}">
              <span class="language-option-code" aria-hidden="true">ID</span><span class="language-option-name">Indonesia</span>
            </button>
            <button type="button" class="language-option" data-language-option data-language-code="hi" role="option" aria-label="Hindi" aria-selected="{% if currentLang == 'hi' %}true{% else %}false{% endif %}">
              <span class="language-option-code" aria-hidden="true">HI</span><span class="language-option-name">हिन्दी</span>
            </button>
            <button type="button" class="language-option" data-language-option data-language-code="ru" role="option" aria-label="Russian" aria-selected="{% if currentLang == 'ru' %}true{% else %}false{% endif %}">
              <span class="language-option-code" aria-hidden="true">RU</span><span class="language-option-name">Русский</span>
            </button>
          </div>
        </div>
        <button class="nav-toggle md:hidden" type="button" aria-expanded="false" aria-label="{{ navToggleLabel | default(m.menu) }}" data-nav-toggle>
          <span class="nav-toggle-icon" aria-hidden="true">
            <span class="nav-toggle-bar"></span>
            <span class="nav-toggle-bar"></span>
            <span class="nav-toggle-bar"></span>
          </span>
        </button>
      </div>
    </nav>
  </header>

  {{ content | safe }}

  <footer class="site-footer relative z-10 px-4 border-t-2 border-[#8BC34A]/10 dark:border-[#8BC34A]/15">
    <div class="footer-shell max-w-6xl mx-auto">
      <div class="footer-primary">
        <nav class="footer-links" aria-label="{{ footerNavLabel }}">
          {% set defaultFooterLinks = [
            { key: "good", label: "Guide", href: "/good/" },
            { key: "api", label: "API", href: "/api/" },
            { key: "about", label: "About", href: "/about/" },
            { key: "for", label: "For", href: "/for/" },
            { key: "privacy", label: "Privacy", href: "/privacy/" },
            { key: "accessibility", label: "Accessibility", href: "/accessibility/" },
            { key: "source", label: "Source", href: "https://github.com/Tofu-Water-Drinker/tofupass", external: true }
          ] %}
          {% set footerLinks = footerNavItems | default(localizedFooter if isLocalized else defaultFooterLinks) %}
          {% for link in footerLinks %}
            {% if link.key == pageKey %}
              <a href="{{ link.href }}" class="footer-link is-active">{{ link.label }}</a>
            {% else %}
              <a href="{{ link.href }}"{% if link.external %} target="_blank" rel="noopener noreferrer"{% endif %} class="footer-link">{{ link.label }}</a>
            {% endif %}
          {% endfor %}
        </nav>
      </div>
      <p class="footer-trust">{{ trustLine }}</p>
      <div class="footer-meta">
        <p class="footer-credit">{{ m.made }} <span class="inline-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m12 20-7-7a4.5 4.5 0 0 1 6.4-6.3L12 7.3l.6-.6A4.5 4.5 0 0 1 19 13z"></path></svg></span> {{ m.by }} <a href="https://tofuwater.com/" target="_blank" rel="noopener noreferrer">TofuWater</a></p>
        {% set footerSocialLinks = footerSocialItems | default(defaultFooterSocialLinks) %}
        {% if footerSocialLinks and footerSocialLinks.length %}
        <span class="footer-meta-divider" aria-hidden="true">|</span>
        <nav class="footer-social-links" aria-label="{{ fm.social }}">
          {% for social in footerSocialLinks %}
            {% if social.href %}
            <a href="{{ social.href }}"{% if social.external %} target="_blank" rel="noopener noreferrer"{% endif %} class="footer-social-link{% if social.icon == 'kofi' %} footer-support-link{% endif %}" aria-label="{{ social.label }}" title="{{ social.label }}">
            {% else %}
            <span class="footer-social-link{% if social.icon == 'kofi' %} footer-support-link{% endif %} is-disabled" role="img" aria-label="{{ social.label }}" title="{{ social.label }}">
            {% endif %}
              {% if social.icon == 'kofi' %}
                <span>{{ social.label }}</span>
              {% elif social.icon == 'bluesky' %}
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 10.8C10.91 8.69 7.95 4.75 5.2 2.81 2.57.94 1.56 1.27.9 1.57.14 1.91 0 3.08 0 3.77c0 .69.38 5.65.62 6.48.82 2.74 3.71 3.66 6.38 3.21-4.59.78-5.44 3.36-3.06 5.93 4.52 4.69 6.5-1.18 7.01-2.68.09-.27.14-.4.22-.4s.13.13.22.4c.51 1.5 2.48 7.36 7.01 2.68 2.38-2.58 1.53-5.16-3.06-5.93 2.67.45 5.57-.47 6.38-3.21.25-.83.62-5.79.62-6.48 0-.69-.14-1.86-.9-2.2-.66-.3-1.66-.62-4.3 1.24-2.75 1.94-5.71 5.88-6.8 7.99Z"></path></svg>
              {% elif social.icon == 'x' %}
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3.2 3h4.6l4.7 6.2L17.9 3h3.2l-7.2 8.2L21.5 21h-4.6l-5.2-6.8L5.7 21H2.5l7.7-8.8L3.2 3Zm4 2.2h-.8l11.4 13.6h.9L7.2 5.2Z"></path></svg>
              {% elif social.icon == 'linkedin' %}
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5.2 8.7h3.1v10H5.2v-10Zm1.5-4.9a1.8 1.8 0 1 1 0 3.6 1.8 1.8 0 0 1 0-3.6Zm3.6 4.9h3v1.4c.4-.8 1.5-1.6 3.1-1.6 3.3 0 3.9 2.2 3.9 5v5.2h-3.1v-4.6c0-1.1 0-2.5-1.5-2.5s-1.8 1.2-1.8 2.4v4.7h-3.1v-10Z"></path></svg>
              {% else %}
                <span aria-hidden="true">{{ social.label | first }}</span>
              {% endif %}
            {% if social.href %}
            </a>
            {% else %}
            </span>
            {% endif %}
            {% if social.icon == 'kofi' and not loop.last %}
            <span class="footer-social-divider" aria-hidden="true">|</span>
            {% endif %}
          {% endfor %}
        </nav>
        {% endif %}
      </div>
    </div>
  </footer>

  {% for script in pageScripts %}<script src="{{ script }}"></script>
  {% endfor %}
  <script src="/assets/js/nav.js"></script>
  <script src="/assets/js/language.js"></script>
  <script src="/assets/js/theme.js"></script>
  <script src="/assets/js/konami.js"></script>
</body>
</html>

      <!-- Languages -->
      <section class="api-section mb-8">
        <div class="flex flex-col sm:flex-row sm:items-start gap-4">
          <div class="flex-1">
            <div class="text-[#8B7355]/60 dark:text-[#B8A890]/60 text-xs font-bold tracking-widest uppercase mb-3">Language support</div>
            <p class="text-[#8B7355] dark:text-[#B8A890] text-sm leading-relaxed mb-4">API output defaults to English. Add the optional <code class="text-[#4A3728]/70 dark:text-[#F0E6D8]/70 mono">lang</code> query parameter to generate passwords or passphrases from another supported language word list.</p>
            <p class="text-[#8B7355] dark:text-[#B8A890] text-sm leading-relaxed">Supported codes: <code class="mono">en</code>, <code class="mono">es</code>, <code class="mono">pt</code>, <code class="mono">fr</code>, <code class="mono">de</code>, <code class="mono">ja</code>, <code class="mono">zh-cn</code>, <code class="mono">ar</code>, <code class="mono">id</code>, <code class="mono">hi</code>, and <code class="mono">ru</code>. If <code class="mono">lang</code> is missing, blank, or unsupported, the API uses English.</p>
          </div>
          <div class="api-mini-code">
            <pre><span class="tok-comment"># Spanish password</span>
curl <span class="tok-url">https://tofupass.com/api/password?lang=es</span>

<span class="tok-comment"># Japanese passphrase</span>
curl <span class="tok-url">https://tofupass.com/api/passphrase?count=4&amp;lang=ja</span></pre>
          </div>
        </div>
      </section>

      <!-- ENDPOINT 1: /api/password -->
      <div class="endpoint-card mb-6 overflow-hidden">
        <div class="endpoint-head">
          <div class="endpoint-title">
            <span class="method-get text-xs font-bold px-3 py-1 rounded-lg mono tracking-wide">GET</span>
            <span class="mono text-[#4A3728]/80 dark:text-[#F0E6D8]/80 font-semibold text-sm sm:text-base">/api/password</span>
          </div>
          <span class="endpoint-desc">Get one password</span>
        </div>
        <div class="px-6 py-6">
          <p class="text-[#8B7355] dark:text-[#B8A890] text-sm mb-5 leading-relaxed">Returns a single server-side generated readable password. The current API password format is two friendly words, one special character, and a two-digit number, with randomized capitalization and symbol placement. This endpoint is separate from the web generator's Soft, Firm, and Extra Firm mode recipes.</p>

          <div class="mb-5">
            <div class="text-xs font-bold text-[#8B7355]/50 dark:text-[#B8A890]/50 uppercase tracking-widest mb-3">Query Parameters</div>
            <div class="param-table">
              <div class="param-row param-head">
                <div>Name</div>
                <div>Type</div>
                <div>Default</div>
                <div>Description</div>
              </div>
              <div class="param-row">
                <div class="mono text-[#9B6DD7]">lang</div>
                <div>string</div>
                <div class="mono text-[#E6A800]">en</div>
                <div>Optional language code for generated words</div>
              </div>
            </div>
          </div>

          <div class="mb-5">
            <div class="text-xs font-bold text-[#8B7355]/50 dark:text-[#B8A890]/50 uppercase tracking-widest mb-2">Request</div>
            <div class="code-block">
              <button class="copy-code-btn" type="button" onclick="copyCode(this, 'curl https://tofupass.com/api/password')">Copy</button>
              <pre><span class="tok-comment"># Using curl</span>
curl <span class="tok-url">https://tofupass.com/api/password</span>

<span class="tok-comment"># Using JavaScript fetch</span>
<span class="tok-key">const</span> res = <span class="tok-key">await</span> fetch(<span class="tok-str">'https://tofupass.com/api/password'</span>);
<span class="tok-key">const</span> password = <span class="tok-key">await</span> res.text();</pre>
            </div>
          </div>

          <div>
            <div class="text-xs font-bold text-[#8B7355]/50 dark:text-[#B8A890]/50 uppercase tracking-widest mb-2">Responses</div>
            <div class="space-y-3">
              <div>
                <div class="flex items-center gap-2 mb-1.5">
                  <span class="status-200 text-xs px-2 py-0.5 rounded font-bold mono">200 OK</span>
                  <span class="response-type">Content-Type: text/plain</span>
                </div>
                <div class="code-block">
                  <pre><span class="tok-str">!HappyTiger83</span></pre>
                </div>
              </div>
              <div>
                <div class="flex items-center gap-2 mb-1.5">
                  <span class="status-429 text-xs px-2 py-0.5 rounded font-bold mono">429 Too Many Requests</span>
                  <span class="response-type">Includes Retry-After</span>
                </div>
                <div class="code-block">
                  <pre><span class="tok-str">too many requests; please slow down</span></pre>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- ENDPOINT 2: /api/passphrase -->
      <div class="endpoint-card mb-6 overflow-hidden">
        <div class="endpoint-head">
          <div class="endpoint-title">
            <span class="method-get text-xs font-bold px-3 py-1 rounded-lg mono tracking-wide">GET</span>
            <span class="mono text-[#4A3728]/80 dark:text-[#F0E6D8]/80 font-semibold text-sm sm:text-base">/api/passphrase</span>
          </div>
          <span class="endpoint-desc">Get a passphrase</span>
        </div>
        <div class="px-6 py-6">
          <p class="text-[#8B7355] dark:text-[#B8A890] text-sm mb-5 leading-relaxed">Returns a hyphen-separated passphrase generated from unique words in the selected word list. Control word count with <code class="text-[#4A3728]/70 dark:text-[#F0E6D8]/70 mono">count</code>, and choose a language with <code class="text-[#4A3728]/70 dark:text-[#F0E6D8]/70 mono">lang</code>.</p>

          <div class="mb-5">
            <div class="text-xs font-bold text-[#8B7355]/50 dark:text-[#B8A890]/50 uppercase tracking-widest mb-3">Query Parameters</div>
            <div class="param-table">
              <div class="param-row param-head">
                <div>Name</div>
                <div>Type</div>
                <div>Default</div>
                <div>Description</div>
              </div>
              <div class="param-row">
                <div class="mono text-[#9B6DD7]">count</div>
                <div>integer</div>
                <div class="mono text-[#E6A800]">4</div>
                <div>Number of unique words, from 4 to 30</div>
              </div>
              <div class="param-row">
                <div class="mono text-[#9B6DD7]">lang</div>
                <div>string</div>
                <div class="mono text-[#E6A800]">en</div>
                <div>Optional language code for generated words</div>
              </div>
            </div>
          </div>

          <div class="mb-5">
            <div class="text-xs font-bold text-[#8B7355]/50 dark:text-[#B8A890]/50 uppercase tracking-widest mb-2">Request</div>
            <div class="code-block">
              <button class="copy-code-btn" type="button" onclick="copyCode(this, 'curl https://tofupass.com/api/passphrase?count=4')">Copy</button>
              <pre><span class="tok-comment"># Default, 4 words</span>
curl <span class="tok-url">https://tofupass.com/api/passphrase</span>

<span class="tok-comment"># Custom word count and language</span>
curl <span class="tok-url">https://tofupass.com/api/passphrase?count=6&amp;lang=fr</span>

<span class="tok-comment"># JavaScript fetch</span>
<span class="tok-key">const</span> res = <span class="tok-key">await</span> fetch(<span class="tok-str">'https://tofupass.com/api/passphrase?count=4'</span>);
<span class="tok-key">const</span> phrase = <span class="tok-key">await</span> res.text();</pre>
            </div>
          </div>

          <div>
            <div class="text-xs font-bold text-[#8B7355]/50 dark:text-[#B8A890]/50 uppercase tracking-widest mb-2">Responses</div>
            <div class="space-y-3">
              <div>
                <div class="flex items-center gap-2 mb-1.5">
                  <span class="status-200 text-xs px-2 py-0.5 rounded font-bold mono">200 OK</span>
                  <span class="response-type">Content-Type: text/plain</span>
                </div>
                <div class="code-block">
                  <pre><span class="tok-str">blooming-tiger-cosmic-leaf</span></pre>
                </div>
              </div>
              <div>
                <div class="flex items-center gap-2 mb-1.5">
                  <span class="status-400 text-xs px-2 py-0.5 rounded font-bold mono">400 Bad Request</span>
                  <span class="response-type">Invalid count</span>
                </div>
                <div class="code-block">
                  <pre><span class="tok-str">count must be between 4 and 30</span></pre>
                </div>
              </div>
              <div>
                <div class="flex items-center gap-2 mb-1.5">
                  <span class="status-429 text-xs px-2 py-0.5 rounded font-bold mono">429 Too Many Requests</span>
                  <span class="response-type">Includes Retry-After</span>
                </div>
                <div class="code-block">
                  <pre><span class="tok-str">too many requests; please try again later</span></pre>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- ENDPOINT 3: /api/languages -->
      <div class="endpoint-card mb-6 overflow-hidden">
        <div class="endpoint-head">
          <div class="endpoint-title">
            <span class="method-get text-xs font-bold px-3 py-1 rounded-lg mono tracking-wide">GET</span>
            <span class="mono text-[#4A3728]/80 dark:text-[#F0E6D8]/80 font-semibold text-sm sm:text-base">/api/languages</span>
          </div>
          <span class="endpoint-desc">Discover languages</span>
        </div>
        <div class="px-6 py-6">
          <p class="text-[#8B7355] dark:text-[#B8A890] text-sm mb-5 leading-relaxed">Returns the default language and every language code accepted by <code class="text-[#4A3728]/70 dark:text-[#F0E6D8]/70 mono">lang</code>. Use this endpoint when building a language picker or validating a client-side integration.</p>

          <div class="mb-5">
            <div class="text-xs font-bold text-[#8B7355]/50 dark:text-[#B8A890]/50 uppercase tracking-widest mb-2">Request</div>
            <div class="code-block">
              <button class="copy-code-btn" type="button" onclick="copyCode(this, 'curl https://tofupass.com/api/languages')">Copy</button>
              <pre>curl <span class="tok-url">https://tofupass.com/api/languages</span></pre>
            </div>
          </div>

          <div>
            <div class="flex items-center gap-2 mb-2">
              <div class="text-xs font-bold text-[#8B7355]/50 dark:text-[#B8A890]/50 uppercase tracking-widest">Response</div>
              <span class="status-200 text-xs px-2 py-0.5 rounded font-bold mono">200 OK</span>
              <span class="response-type">Content-Type: application/json</span>
            </div>
            <div class="code-block">
              <pre>{
  <span class="tok-key">"default"</span>: <span class="tok-str">"en"</span>,
  <span class="tok-key">"supported"</span>: [
    <span class="tok-str">"en"</span>, <span class="tok-str">"es"</span>, <span class="tok-str">"pt"</span>, <span class="tok-str">"fr"</span>, <span class="tok-str">"de"</span>, <span class="tok-str">"ja"</span>,
    <span class="tok-str">"zh-cn"</span>, <span class="tok-str">"ar"</span>, <span class="tok-str">"id"</span>, <span class="tok-str">"hi"</span>, <span class="tok-str">"ru"</span>
  ]
}</pre>
            </div>
          </div>
        </div>
      </div>

      <!-- ENDPOINT 4: /api/stats -->
      <div class="endpoint-card mb-8 overflow-hidden">
        <div class="endpoint-head">
          <div class="endpoint-title">
            <span class="method-get text-xs font-bold px-3 py-1 rounded-lg mono tracking-wide">GET</span>
            <span class="mono text-[#4A3728]/80 dark:text-[#F0E6D8]/80 font-semibold text-sm sm:text-base">/api/stats</span>
          </div>
          <span class="endpoint-desc">Usage statistics</span>
        </div>
        <div class="px-6 py-6">
          <p class="text-[#8B7355] dark:text-[#B8A890] text-sm mb-5 leading-relaxed">Returns aggregate in-memory counters for the TofuPass API. These counters reset when the server restarts. No generated passwords, passphrases, user data, or sessions are tracked.</p>

          <div class="mb-5">
            <div class="text-xs font-bold text-[#8B7355]/50 dark:text-[#B8A890]/50 uppercase tracking-widest mb-2">Request</div>
            <div class="code-block">
              <button class="copy-code-btn" type="button" onclick="copyCode(this, 'curl https://tofupass.com/api/stats')">Copy</button>
              <pre>curl <span class="tok-url">https://tofupass.com/api/stats</span></pre>
            </div>
          </div>

          <div>
            <div class="flex items-center gap-2 mb-2">
              <div class="text-xs font-bold text-[#8B7355]/50 dark:text-[#B8A890]/50 uppercase tracking-widest">Response</div>
              <span class="status-200 text-xs px-2 py-0.5 rounded font-bold mono">200 OK</span>
              <span class="response-type">Content-Type: application/json</span>
            </div>
            <div class="code-block">
              <pre>{
  <span class="tok-key">"generated_passwords"</span>: <span class="tok-num">12453</span>,
  <span class="tok-key">"generated_passphrases"</span>: <span class="tok-num">3821</span>,
  <span class="tok-key">"total_api_calls"</span>: <span class="tok-num">16274</span>
}</pre>
            </div>
          </div>
        </div>
      </div>

      <!-- Rate limits -->
      <div class="endpoint-card mb-6 overflow-hidden">
        <div class="px-6 py-5 border-b border-[#6BBF59]/10">
          <div class="text-xs font-bold text-[#8B7355]/50 dark:text-[#B8A890]/50 uppercase tracking-widest mb-2">Rate limits</div>
          <h2 class="text-2xl font-black text-[#4A3728] dark:text-[#F0E6D8]">Fair, private limits</h2>
        </div>
        <div class="px-6 py-6">
          <p class="text-[#8B7355] dark:text-[#B8A890] text-sm leading-relaxed mb-5">The live generation endpoints allow a sustained 1 password or passphrase per second, a small burst cushion of 10 requests, and 1,000 generation requests per hour. Requests above those limits return <code class="text-[#4A3728]/70 dark:text-[#F0E6D8]/70 mono">429 Too Many Requests</code> with a retry hint.</p>

          <div class="rate-grid rate-grid-single">
            <div>
              <span class="rate-label">Response headers</span>
              <code>X-RateLimit-Limit</code>
              <code>X-RateLimit-Remaining-Hour</code>
              <code>Retry-After</code>
            </div>
          </div>
        </div>
      </div>

      <!-- Privacy Note -->
      <div class="api-note p-5 border border-[#6BBF59]/15">
        <div class="flex items-start gap-3">
          <div class="text-[#6BBF59] text-xl mt-0.5"><span class="inline-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="9" rx="2"></rect><path d="M8 11V8a4 4 0 1 1 8 0v3"></path></svg></span></div>
          <div>
            <div class="font-semibold text-[#6BBF59] text-sm mb-1">API Privacy</div>
            <p class="text-[#8B7355] dark:text-[#B8A890] text-sm leading-relaxed">All API responses are generated in real time using Node's cryptographically secure <code class="text-[#4A3728]/70 dark:text-[#F0E6D8]/70 mono">crypto.randomInt</code>. Generated values are returned in the immediate response; TofuPass does not intentionally log or store generated passwords or passphrases.</p>
          </div>
        </div>
      </div>

      <!-- Open Source Note -->
      <div class="api-note p-5 border border-[#6BBF59]/15 mt-4">
        <div class="flex items-start gap-3">
          <div class="text-[#6BBF59] text-xl mt-0.5"><span class="inline-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg></span></div>
          <div>
            <div class="font-semibold text-[#6BBF59] text-sm mb-1">Open Source (GPL v3)</div>
            <p class="text-[#8B7355] dark:text-[#B8A890] text-sm leading-relaxed">This API server is open source. Audit the implementation on <a href="https://github.com/Tofu-Water-Drinker/tofupass-api" target="_blank" rel="noopener noreferrer" class="text-[#6BBF59] dark:text-[#7DD668] underline underline-offset-2 font-bold">GitHub</a>. The <a href="https://github.com/Tofu-Water-Drinker/tofupass" target="_blank" rel="noopener noreferrer" class="text-[#6BBF59] dark:text-[#7DD668] underline underline-offset-2 font-bold">frontend site</a> is too. Both are under GPL v3. The TofuPass name and mascot are brand assets.</p>
          </div>
        </div>
      </div>

    </div>

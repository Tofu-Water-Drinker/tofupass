          <button class="copy-code-btn" type="button" onclick="copyCode(this, 'curl https://tofupass.com/api/password')">Copy</button>
          <pre><span class="tok-comment"># One generated password</span>
curl <span class="tok-url">https://tofupass.com/api/password</span>

<span class="tok-comment"># Six-word passphrase</span>
curl <span class="tok-url">https://tofupass.com/api/passphrase?count=6</span>

<span class="tok-comment"># Discover supported language codes</span>
curl <span class="tok-url">https://tofupass.com/api/languages</span></pre>

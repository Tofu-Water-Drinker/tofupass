      <!-- Section 1: The Hard Truth -->
      <section class="mb-16">
        <div class="flex items-center gap-3 mb-5">
          <div class="section-dot section-dot-pink" aria-hidden="true">
            <svg viewBox="0 0 24 24" class="w-5 h-5"><path d="M12 4 20 19H4z" stroke="currentColor" fill="none" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"></path><path d="M12 9v4" stroke="currentColor" fill="none" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"></path><path d="M12 17h.01" stroke="currentColor" fill="none" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          </div>
          <h2 class="text-xl font-extrabold text-[#4A3728] dark:text-[#F0E6D8]">الحقيقة الصعبة</h2>
        </div>
        <p class="text-[#8B7355] dark:text-[#B8A890] leading-relaxed text-base mb-5">
          نظراً لما يكفي من الوقت والقوة الحاسوبية، يمكن في نهاية المطاف كسر أي كلمة سر. القفل على بابك الأمامي يمكن اختياره أيضاً لكن هذا لا يعني أن الأقفال عديمة الفائدة
        </p>
        <div class="callout-strip callout-strip-yellow">
          <p class="text-[#4A3728] dark:text-[#F0E6D8] font-bold text-base leading-relaxed">الهدف الحقيقي؟ كن <span class="text-[#E6A800]">باهظ الثمن</span>.</p>
          <p class="text-[#8B7355] dark:text-[#B8A890] text-sm mt-2 leading-relaxed">المهاجمون لا يستهدفون الأفراد باليد وهي تدير أدوات آلية ضد ملايين الحسابات في وقت واحد. إذا كسر كلمة المرور الخاصة بك سوف يستغرق قرون على المعدات الحديثة، كنت آمنة في الممارسة العملية.</p>

      <!-- Section 3: Two Recipes -->
      <section class="mb-16">
        <div class="flex items-center gap-3 mb-8">
          <div class="section-dot section-dot-yellow" aria-hidden="true">
            <svg viewBox="0 0 24 24" class="w-5 h-5"><path d="M6 7h12" stroke="currentColor" fill="none" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"></path><path d="M6 12h10" stroke="currentColor" fill="none" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"></path><path d="M6 17h8" stroke="currentColor" fill="none" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          </div>
          <h2 class="text-xl font-extrabold text-[#4A3728] dark:text-[#F0E6D8]">Dos recetas que funcionan</h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">

          <!-- Standard Password -->
          <div class="recipe-strip recipe-strip-pink">
            <div class="text-xs font-extrabold tracking-widest text-[#FF7A7A] uppercase mb-3">Contraseña estándar</div>
            <div class="font-mono text-[#FF7A7A] font-bold text-lg mb-4 break-all">DancingKoalaRiver!73</div>
            <ul class="space-y-2 text-sm text-[#8B7355]">
              <li class="flex items-start gap-2"><span class="inline-icon text-[#FF7A7A] mt-0.5" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m5 12 4 4 10-10"></path></svg></span> Cartas de caso mixtas</li>
              <li class="flex items-start gap-2"><span class="inline-icon text-[#FF7A7A] mt-0.5" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m5 12 4 4 10-10"></path></svg></span> Símbolo común</li>
              <li class="flex items-start gap-2"><span class="inline-icon text-[#FF7A7A] mt-0.5" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m5 12 4 4 10-10"></path></svg></span> Números de rastreo</li>
              <li class="flex items-start gap-2"><span class="inline-icon text-[#FF7A7A] mt-0.5" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m5 12 4 4 10-10"></path></svg></span> Tres palabras legibles</li>
              <li class="flex items-start gap-2 mt-3 font-semibold"><span class="inline-icon text-[#FF7A7A] mt-0.5" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12h13"></path><path d="m14 7 5 5-5 5"></path></svg></span> Ideal para uso diario</li>
            </ul>
          </div>

          <!-- Passphrase -->
          <div class="recipe-strip recipe-strip-green">
            <div class="text-xs font-extrabold tracking-widest text-[#6BBF59] uppercase mb-3">Passphrase</div>
            <div class="font-mono text-[#6BBF59] font-bold text-lg mb-4 break-all">florecer-tiger-cosmic-leaf</div>
            <ul class="space-y-2 text-sm text-[#8B7355]">
              <li class="flex items-start gap-2"><span class="inline-icon text-[#6BBF59] mt-0.5" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m5 12 4 4 10-10"></path></svg></span> 4 palabras al azar</li>
              <li class="flex items-start gap-2"><span class="inline-icon text-[#6BBF59] mt-0.5" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m5 12 4 4 10-10"></path></svg></span> Hifeno separado</li>
              <li class="flex items-start gap-2"><span class="inline-icon text-[#6BBF59] mt-0.5" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m5 12 4 4 10-10"></path></svg></span> Mejor cuando se permite la longitud</li>
              <li class="flex items-start gap-2"><span class="inline-icon text-[#6BBF59] mt-0.5" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m5 12 4 4 10-10"></path></svg></span> Fácil de escribir</li>
              <li class="flex items-start gap-2 mt-3 font-semibold"><span class="inline-icon text-[#6BBF59] mt-0.5" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12h13"></path><path d="m14 7 5 5-5 5"></path></svg></span> Mejor para bóvedas de memoria</li>
            </ul>
          </div>

        </div>
      </section>

      <!-- Divider -->
      <div class="flex justify-center mb-16">

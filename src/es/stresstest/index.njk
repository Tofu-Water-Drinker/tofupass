  <!-- CONTENT -->
  <main class="relative z-10 pt-28 pb-20 px-4">
    <div class="max-w-xl mx-auto">

      <!-- Header -->
      <div class="text-center mb-10">
        <h1 class="text-4xl sm:text-5xl font-black mb-4 text-[#4A3728] dark:text-[#F0E6D8]"><span class="gradient-text">Stress</span> Tester</h1>
        <p class="text-[#8B7355] dark:text-[#B8A890] text-base max-w-sm mx-auto">¿Cuánto tardaría una computadora en romper su contraseña? ¿Y ya se ha filtrado?</p>
      </div>

      <!-- MAIN CARD -->
      <div class="main-card glass rounded-3xl p-6 sm:p-8 mb-6">

        <!-- Password Input -->
        <div class="mb-6">
          <label class="block text-xs font-bold text-[#8B7355] dark:text-[#B8A890] uppercase tracking-widest mb-2">Su contraseña</label>
          <input
            id="password"
            type="password"
            placeholder="Introduzca una contraseña para analizar..."
            autocomplete="off"
            autocorrect="off"
            autocapitalize="off"
            spellcheck="false"
            class="pw-input"
          />
          <div class="flex items-center justify-between mt-2">
            <button onclick="toggleVisibility()" id="visBtn"
              class="text-xs text-[#8B7355]/50 dark:text-[#B8A890]/50 hover:text-[#4A3728] dark:hover:text-[#F0E6D8] transition-colors flex items-center gap-1">
              <span id="visIcon">👁</span> <span id="visText">Show</span>
            </button>
            <div id="char-count" class="text-xs text-[#8B7355]/40 dark:text-[#B8A890]/40"></div>
          </div>
        </div>

        <!-- Strength Meter -->
        <div class="mb-6">
          <div class="flex items-center justify-between mb-2">
            <label class="text-xs font-bold text-[#8B7355] dark:text-[#B8A890] uppercase tracking-widest">Fuerza</label>
            <span id="strength-label" class="strength-label text-[#8B7355]/50 dark:text-[#B8A890]/50 bg-[#6BBF59]/5 dark:bg-[#7DD668]/10">Esperando</span>
          </div>
          <div class="meter-track">
            <div id="meter-fill"></div>
          </div>
        </div>

        <!-- Hardware Select -->
        <div class="mb-6">
          <div class="flex items-center gap-2 mb-2">
            <label class="text-xs font-bold text-[#8B7355] dark:text-[#B8A890] uppercase tracking-widest" for="hardware">Hardware de ataque</label>
            <div class="tooltip-wrap">
              <button class="w-4 h-4 rounded-full bg-[#6BBF59]/10 dark:bg-[#7DD668]/15 text-[#8B7355] dark:text-[#B8A890] text-xs flex items-center justify-center hover:bg-[#6BBF59]/20 dark:hover:bg-[#7DD668]/25 transition-colors">?</button>
              <div class="tooltip-content">
                <strong class="text-[#4A3728] dark:text-[#F0E6D8]">Velocidad de ataque</strong> representa cuántas conjeturas de contraseña por segundo el hardware puede hacer. Las GPU modernas pueden probar miles de millones de hashes por segundo contra bases de datos sin conexión.
              </div>
            </div>
          </div>
          <select id="hardware" class="hw-select">
            <option value="1e9">GPU de consumo (1 mil millones/s)</option>
            <option value="1e10">High-end Gaming PC (10 billion/sec)</option>
            <option value="1e12">Botnet / Cloud Cluster (1 trillion/sec)</option>
            <option value="1e14">Hardware nacional-estatal (100 billones/seg)</option>
          </select>
        </div>

        <!-- Time Display -->
        <div class="mb-6 text-center py-6 border-y-2 border-[#6BBF59]/8 dark:border-[#7DD668]/12">
          <div class="text-xs font-bold text-[#8B7355]/50 dark:text-[#B8A890]/50 uppercase tracking-widest mb-3">Tiempo estimado de Crack</div>
          <div id="time-display">Aún no.</div>
          <div id="scanning-text" class="text-xs text-[#8B7355]/40 dark:text-[#B8A890]/40 mt-2 h-4"></div>
        </div>

        <!-- Breach Alert -->
        <div id="breach-card">
          <div class="flex items-start gap-3">
            <div class="text-2xl">🚨</div>
            <div>
              <div class="font-bold text-[#FF7A7A] text-sm mb-1">encontrado en Data Breaches</div>
              <p id="breach-text" class="text-[#4A3728]/70 dark:text-[#F0E6D8]/70 text-sm leading-relaxed"></p>
              <p class="text-[#8B7355]/50 dark:text-[#B8A890]/50 text-xs mt-2">Deja de usar esta contraseña inmediatamente. Genera uno nuevo arriba.</p>
            </div>
          </div>
        </div>

      </div>

      <!-- How it works / Privacy note -->
      <div class="glass rounded-2xl p-5 mb-6">
        <div class="flex items-start gap-3">
          <div class="text-xl mt-0.5">
            <div class="tooltip-wrap">
              🔑
              <div class="tooltip-content" style="left: 0; transform: none;">
                <strong class="text-[#4A3728] dark:text-[#F0E6D8]">k-Anonymity</strong>: Sólo los primeros 5 caracteres del hash SHA-1 de su contraseña son enviados a Haber sido Pwned. El hash completo y tu contraseña real nunca dejan tu dispositivo. La API devuelve todos los hashes con ese prefijo, y la coincidencia se hace localmente.
              </div>
            </div>
          </div>
          <div>
            <div class="font-semibold text-[#4A3728] dark:text-[#F0E6D8] text-sm mb-1">Comprobación de brechas con privacidad preservada</div>
            <p class="text-[#8B7355] dark:text-[#B8A890] text-xs leading-relaxed">Usos de detección de estómago <strong class="text-[#4A3728] dark:text-[#F0E6D8]">k-Anonymity</strong> He sido Pwned. Su contraseña real nunca se transmite. Sólo se envía un prefijo de 5 caracteres. Abra el icono clave para aprender más.</p>
          </div>
        </div>
      </div>

      <!-- Stats Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <div class="stat-box">
          <div class="text-lg font-black text-[#4A3728] dark:text-[#F0E6D8]" id="stat-length">0</div>
          <div class="text-xs text-[#8B7355]/60 dark:text-[#B8A890]/60 mt-1">Personajes</div>
        </div>
        <div class="stat-box">
          <div class="text-lg font-black text-[#4A3728] dark:text-[#F0E6D8]" id="stat-pool">0</div>
          <div class="text-xs text-[#8B7355]/60 dark:text-[#B8A890]/60 mt-1">Tamaño de la piscina</div>
        </div>
        <div class="stat-box">
          <div class="text-lg font-black text-[#4A3728] dark:text-[#F0E6D8]" id="stat-entropy">0</div>
          <div class="text-xs text-[#8B7355]/60 dark:text-[#B8A890]/60 mt-1">Bits of Entropy</div>
        </div>
      </div>

    </div>
  </main>

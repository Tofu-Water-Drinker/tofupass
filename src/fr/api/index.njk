                <div>Par défaut</div>
                <div>Désignation des marchandises</div>
              </div>
              <div class="param-row">
                <div class="mono text-[#9B6DD7]">lang</div>
                <div>string</div>
                <div class="mono text-[#E6A800]">en</div>
                <div>Code linguistique optionnel pour les mots générés</div>
              </div>
            </div>
          </div>

          <div class="mb-5">
            <div class="text-xs font-bold text-[#8B7355]/50 dark:text-[#B8A890]/50 uppercase tracking-widest mb-2">Demande</div>
            <div class="code-block">

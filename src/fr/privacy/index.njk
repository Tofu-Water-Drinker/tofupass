          </li>
          <li>
            <span class="inline-icon text-[#FF7A7A] mt-0.5 text-lg" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 7 17 17"></path><path d="M17 7 7 17"></path></svg></span>
            <div>
              <div class="text-[#4A3728]/85 dark:text-[#F0E6D8]/85 text-sm font-semibold">Comptes et profils</div>
              <div class="text-[#8B7355]/60 dark:text-[#B8A890]/60 text-xs mt-0.5">Pas de connexion, de profils d'utilisateurs ou d'identificateurs de compte.</div>
            </div>
          </li>
          <li>
            <span class="inline-icon text-[#FF7A7A] mt-0.5 text-lg" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 7 17 17"></path><path d="M17 7 7 17"></path></svg></span>
            <div>
              <div class="text-[#4A3728]/85 dark:text-[#F0E6D8]/85 text-sm font-semibold">Analyse</div>
              <div class="text-[#8B7355]/60 dark:text-[#B8A890]/60 text-xs mt-0.5">Pas de Google Analytics, Plausible, Fathom, ou tout script de suivi.</div>
            </div>
          </li>
          <li>
            <span class="inline-icon text-[#FF7A7A] mt-0.5 text-lg" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 7 17 17"></path><path d="M17 7 7 17"></path></svg></span>
            <div>
              <div class="text-[#4A3728]/85 dark:text-[#F0E6D8]/85 text-sm font-semibold">Publicité</div>
              <div class="text-[#8B7355]/60 dark:text-[#B8A890]/60 text-xs mt-0.5">Pas de réseau publicitaire. Pas de publicité ciblée. Pas de suivi monétisé.</div>
            </div>
          </li>

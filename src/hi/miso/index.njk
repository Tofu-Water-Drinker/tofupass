  <!-- HERO -->
  <div class="relative z-10 pt-28 pb-4 px-4 text-center">
    <div class="flex justify-center mb-5">
      <div class="mascot-ring">
        <img src="/excited.png" alt="Miso TofuPass mascot" class="mascot-hero w-[11rem] h-[11rem] relative z-10" />
      </div>
    </div>
    <h1 class="text-5xl sm:text-7xl font-black mb-2 text-[#4A3728] dark:text-[#F0E6D8]">मैं हूँ <span class="gradient-text">मिसो!</span></h1>
    <p class="miso-kicker">आपका नरम, squishy सुरक्षा अभिभावक</p>

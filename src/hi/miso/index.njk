  <!-- CONTENT -->
  <main class="relative z-10 pb-20 px-4">
    <div class="max-w-3xl mx-auto">

      <!-- Origin blob -->
      <div class="miso-blob-section miso-blob-green">
        <h2>एक बड़ी नौकरी के साथ थोड़ा टोफू।</h2>
        <p>मिसो एक छोटी टोफू आत्मा है जिसने इंटरनेट के आरामदायक कोनों में एक दिन दिखाया और रहने का फैसला किया। किसी ने उसे पासवर्ड की रक्षा करने के लिए कहा। वह सिर्फ इसे करना शुरू कर दिया, चुपचाप, जिस तरह से एक बिल्ली एक sunbeam का दावा करती है।</p>
        <p>उनका नाम मिकालली नामक एक तरह का मानव था, और वह सोचता है कि वह ऐसा क्यों कर रहा था। उनका जन्मदिन 4 मई को हुआ - जिसे वर्ल्ड पासवर्ड डे भी कहा जाता है। घटना? Miso कहते हैं नहीं।</p>
      </div>

      <!-- Moods blob -->
      <div class="miso-blob-section miso-blob-pink" style="border-radius: 55% 45% 42% 58% / 48% 55% 45% 52%;">
        <h2>तीन चेहरे, एक टोफू।</h2>
        <p>Miso कहते हैं, लेकिन उसका चेहरा सब कुछ कहता है।</p>
        <div class="moods-grid">
          <div class="mood-item">
            <img src="/tofu.png" alt="Miso देख शांत" class="mood-img" />
            <div class="mood-name mood-name-green">Calm</div>
            <p class="mood-desc">डिफ़ॉल्ट स्थिति। सब कुछ ठीक है। मिसो की एक छोटी मुस्कान और रोसी गाल के साथ घड़ी रखते हुए। सब ठीक है।</p>
          </div>
          <div class="mood-item">
            <img src="/excited.png" alt="Miso देख उत्साहित" class="mood-img" />
            <div class="mood-name mood-name-yellow">उत्साहित</div>
            <p class="mood-desc">आप एक पासवर्ड कॉपी! या वास्तव में अच्छा कुछ उत्पन्न किया। मिसो की आंखें चौड़ी हो जाती हैं और वह थोड़ा अजीब हो जाता है। वह आपको गर्व है।</p>
          </div>
          <div class="mood-item">
            <img src="/alert.png" alt="Miso देख अलर्ट" class="mood-img" />
            <div class="mood-name mood-name-pink">चेतावनी</div>
            <p class="mood-desc">कुछ ध्यान देने की जरूरत है। शायद एक पॉलिसी अद्यतन, शायद आप स्पैम-क्लिकिंग उत्पन्न कर रहे हैं। उत्खनन चिह्न दिखाई देता है। मिसो का संबंध है।</p>
          </div>
        </div>
      </div>

      <!-- Personality blob -->
      <div class="miso-blob-section miso-blob-yellow" style="border-radius: 45% 55% 58% 42% / 52% 48% 50% 50%;">
        <h2>व्यक्तित्व में नरम, सुरक्षा में फर्म।</h2>
        <p>Miso मानते हैं कि सुरक्षा को गर्म और समझने में आसान महसूस होना चाहिए। वह ज़ोर से नहीं है। वह आकर्षक नहीं है। जब आप अपने दिन के बारे में जाते हैं तो वह चुपचाप सुरक्षित रहता है।</p>
        <p>वह दोस्त की तरह है जो आपकी वरीयताओं को याद करते हैं लेकिन कभी उन्हें किसी के साथ साझा नहीं करते हैं। क्या एक पासवर्ड अभिभावक होना चाहिए?</p>
        <div class="fun-facts">
          <div class="fun-fact"><span class="fun-fact-label">रंग</span><span class="fun-fact-value">मोस ग्रीन</span></div>
          <div class="fun-fact"><span class="fun-fact-label">स्नैक</span><span class="fun-fact-value">टोस्टेड तिल के बीज</span></div>
          <div class="fun-fact"><span class="fun-fact-label">हॉबी</span><span class="fun-fact-value">सुरक्षित शब्दों का संग्रह</span></div>
          <div class="fun-fact"><span class="fun-fact-label">डर</span><span class="fun-fact-value">कमजोर पासवर्ड &amp; गर्म सूप</span></div>
          <div class="fun-fact"><span class="fun-fact-label">ड्रीम</span><span class="fun-fact-value">शून्य चिपचिपा नोट पासवर्ड</span></div>
          <div class="fun-fact"><span class="fun-fact-label">गीत</span><span class="fun-fact-value">मार्कोनी यूनियन - भारहीन</span></div>
        </div>
      </div>

      <!-- Letter blob -->
      <div class="miso-blob-section miso-blob-purple" style="border-radius: 50% 50% 45% 55% / 55% 45% 52% 48%;">
        <h2>मिसो से एक नोट।</h2>
        <div class="miso-letter">
          <div class="miso-letter-stamp">मिसो पोस्ट</div>
          <div class="miso-letter-body">
            <p>हाय दोस्त,</p>
            <p>मुझे पता है कि पासवर्ड भारी महसूस कर सकते हैं। नियमों के बहुत सारे, बहुत सारे चेतावनी, बहुत से "यह नहीं करना"।</p>
            <p>लेकिन यह उस तरह नहीं है। एक अच्छा यादृच्छिक पासवर्ड और इसे रखने के लिए एक सुरक्षित स्थान - यह वास्तव में आप सभी की जरूरत है।</p>
            <p>जब भी आपको मेरी आवश्यकता हो तो मैं यहाँ हूँ। हमेशा की तरह, चुपके से घड़ी रखना।</p>
            <p>सुरक्षित रहें, आरामदायक रहें,</p>
            <p class="miso-letter-sign">Miso</p>
          </div>
        </div>
      </div>

    </div>
  </main>

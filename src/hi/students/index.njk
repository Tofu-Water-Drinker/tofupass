              <div class="certificate-grade-row">
                <span id="certificateGrade">कुल मिलाकर ग्रेड: -</span>
                <span id="certificateDate">तारीख: -</span>
              </div>
              <div id="certificateModules" class="certificate-modules"></div>
            </div>
          </article>
        </div>

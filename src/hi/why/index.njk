      <article class="why-article">

        <!-- Section 1 -->
        <section class="why-section">
          <div class="why-section-label why-label-pink">समस्या</div>
          <h2>पासवर्ड लोग सुरक्षित नहीं रह सकते हैं।</h2>
          <p>वहाँ पहले से ही महान पासवर्ड जनरेटर हैं। उदाहरण के लिए, DinoPass, पासवर्ड निर्माण सरल और सुलभ बनाता है। मैंने इसे साल तक इस्तेमाल किया।</p>
          <p>लेकिन मैं आईटी में काम करता हूँ। और मैंने जिस पैटर्न को देखा था वह उपकरण की कमी नहीं थी - यह क्या हुआ <em>बाद में</em> लोगों को अपना पासवर्ड मिला। वे इसे पुन: उपयोग करते हैं, इसे सरल करते हैं, या इसे उनके मॉनिटर पर टेप करते हैं।</p>
        </section>

        <!-- Divider -->
        <div class="why-divider" aria-hidden="true">
          <svg class="w-36 h-3 text-[#FFD166]/25" viewBox="0 0 150 12" fill="none">
            <path d="M0 6 C 18 0, 37 12, 56 6 S 93 0, 112 6 S 131 12, 150 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>

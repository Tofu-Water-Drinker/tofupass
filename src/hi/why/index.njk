        </div>

        <!-- Section 2 -->
        <section class="why-section">
          <div class="why-section-label why-label-yellow">ट्रिगर</div>
          <h2>छोटे घर्षण, बड़े परिणाम।</h2>
          <p>क्षण एक पासवर्ड एक घर्षण सीमा पार करता है, लोग काम करना बंद कर देते हैं <em>साथ</em> यह और काम शुरू करना <em>आसपास</em> यह ट्रिगर हमेशा समान होते हैं:</p>
          <div class="why-grid">
            <div class="why-grid-item">बहुत सारी पूंजी</div>
            <div class="why-grid-item">Unfamiliar प्रतीक</div>
            <div class="why-grid-item">लंबे यादृच्छिक स्ट्रिंग</div>
            <div class="why-grid-item">चरित्र प्रतिस्थापन</div>
          </div>
        </section>

        <!-- Sticky note -->
        <div class="sticky-note-wrap">
          <div class="sticky-note">
            <div class="sticky-note-tape"></div>
            <p class="sticky-note-text">P@ssw0rd123!</p>

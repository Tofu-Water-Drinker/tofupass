der-y-2 border-[#6BBF59]/8 dark:border-[#7DD668]/12"><div class="text-xs font-bold text-[#8B7355]/50 dark:text-[#B8A890]/50 uppercase tracking-widest mb-3">Perkiraan waktu bobol</div><div id="time-display">Not yet</div><div id="scanning-text" class="text-xs text-[#8B7355]/40 dark:text-[#B8A890]/40 mt-2 h-4"></div></div><div id="breach-card"><div class="flex items-start gap-3"><div class="text-2xl">🚨</div><div><div class="font-bold text-[#FF7A7A] text-sm mb-1">Breach</div><p id="breach-text" class="text-[#4A3728]/70 dark:text-[#F0E6D8]/70 text-sm leading-relaxed"></p></div></div></div></div><div class="grid grid-cols-1 sm:grid-cols-3 gap-3"><div class="stat-box"><div class="text-lg font-black text-[#4A3728] dark:text-[#F0E6D8]" id="stat-length">0</div><div class="text-xs text-[#8B7355]/60 dark:text-[#B8A890]/60 mt-1">Length</div></div><div class="stat-box"><div class="text-lg font-black text-[#4A3728] dark:text-[#F0E6D8]" id="stat-pool">0</div><div class="text-xs text-[#8B7355]/60 dark:text-[#B8A890]/60 mt-1">Pool</div></div><div class="stat-box"><div class="text-lg font-black text-[#4A3728] dark:text-[#F0E6D8]" id="stat-entropy">0</div><div class="text-xs text-[#8B7355]/60 dark:text-[#B8A890]/60 mt-1">Entropy</div></div></div></div></main>

          <p class="text-xs text-[#8B7355] dark:text-[#B8A890] leading-relaxed">Quick shares, temporary access, and anything you'll read out loud.<br/>2 words + symbol + number<br/>e.g. <span class="text-[#4A3728] dark:text-[#F0E6D8] font-mono font-bold">HappyKoala!73</span></p>
        </div>

        <!-- Firm -->
        <div class="level-card p-5 text-left"
          id="card-firm" onclick="selectLevel('firm')" role="radio" aria-checked="false" tabindex="-1">
          <div class="ui-icon level-icon icon-firm" aria-hidden="true">

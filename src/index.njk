  <!-- LIGHTWEIGHT CONTEXT SECTION (open layout, no cards) -->
  <section id="why-tofupass" class="relative z-10 pt-16 pb-20 px-4">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-14">
        <h2 class="text-3xl sm:text-4xl font-black mb-3 text-[#4A3728] dark:text-[#F0E6D8]">A password generator for the awkward bits.</h2>
        <p class="text-[#8B7355] dark:text-[#B8A890] text-base max-w-2xl mx-auto font-medium">Browser and password manager generators are great when autofill handles everything. TofuPass is for the reset call, classroom handout, Wi-Fi label, router screen, family setup, or demo where a human has to read and type the secret.</p>
      </div>
      <div class="features-open grid grid-cols-1 md:grid-cols-3 gap-12 md:gap-10">

        <!-- Feature 1 -->
        <div class="feature-open text-center">
          <div class="feature-dot feature-dot-violet mx-auto mb-5" aria-hidden="true">
            <svg viewBox="0 0 24 24" class="w-6 h-6">
              <rect x="5" y="11" width="14" height="10" rx="2" stroke="currentColor" fill="none" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"></rect>
              <path d="M8 11V8a4 4 0 1 1 8 0v3" stroke="currentColor" fill="none" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </div>
          <h3 class="text-lg font-extrabold mb-2 text-[#4A3728] dark:text-[#F0E6D8]">Readable on Purpose</h3>
          <p class="text-[#8B7355] dark:text-[#B8A890] text-sm leading-relaxed">Clear word-based recipes with a symbol and short number make passwords easier to say, type, verify, and hand off without teaching weak habits.</p>
        </div>

        <!-- Feature 2 -->
        <div class="feature-open text-center">
          <div class="feature-dot feature-dot-green mx-auto mb-5" aria-hidden="true">
            <svg viewBox="0 0 24 24" class="w-6 h-6">
              <path d="M12 3l7 3v5c0 5-3.2 8.4-7 10-3.8-1.6-7-5-7-10V6l7-3z" stroke="currentColor" fill="none" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </div>
          <h3 class="text-lg font-extrabold mb-2 text-[#4A3728] dark:text-[#F0E6D8]">Private by Default</h3>
          <p class="text-[#8B7355] dark:text-[#B8A890] text-sm leading-relaxed">The web generator runs in your browser with <code class="text-[#6BBF59] font-mono text-xs font-bold">crypto.getRandomValues()</code>. No accounts, no ads, no analytics, and no generated passwords stored by TofuPass.</p>
        </div>

        <!-- Feature 3 -->
        <div class="feature-open text-center">
          <div class="feature-dot feature-dot-yellow mx-auto mb-5" aria-hidden="true">
            <svg viewBox="0 0 24 24" class="w-6 h-6">
              <path d="M6 8.5c0-1.4 1.1-2.5 2.5-2.5h7c1.4 0 2.5 1.1 2.5 2.5v7c0 1.4-1.1 2.5-2.5 2.5h-7C7.1 18 6 16.9 6 15.5z" stroke="currentColor" fill="none" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"></path>
              <path d="M9 10h6" stroke="currentColor" fill="none" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"></path>
              <path d="M9 14h4" stroke="currentColor" fill="none" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </div>
          <h3 class="text-lg font-extrabold mb-2 text-[#4A3728] dark:text-[#F0E6D8]">Built to Pair With a Manager</h3>
          <p class="text-[#8B7355] dark:text-[#B8A890] text-sm leading-relaxed">TofuPass creates the handoff password. A real password manager should store long-term secrets, handle autofill, and protect your everyday accounts.</p>
        </div>
      </div>
    </div>
  </section>


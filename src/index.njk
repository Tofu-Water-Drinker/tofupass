        <!-- Soft -->
        <div class="level-card p-5 text-left active-soft"
          id="card-soft" onclick="selectLevel('soft')" role="radio" aria-checked="true" tabindex="0">
          <div class="ui-icon level-icon icon-soft" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <path d="M12 12c0-3-2-5-4-5-1.7 0-3 1.3-3 3 0 2 2 4 7 7"></path>
              <path d="M12 12c0-3 2-5 4-5 1.7 0 3 1.3 3 3 0 2-2 4-7 7"></path>
              <circle cx="12" cy="12" r="1.5"></circle>
            </svg>
          </div>

          <div class="mb-5">
            <div class="text-xs font-bold text-[#8B7355]/50 dark:text-[#B8A890]/50 uppercase tracking-widest mb-3">クエリパラメータ</div>
            <div class="param-table">
              <div class="param-row param-head">
                <div>お名前 (必須)</div>
                <div>タイプ:</div>
                <div>デフォルト</div>
                <div>コンテンツ</div>
              </div>
              <div class="param-row">
                <div class="mono text-[#9B6DD7]">count</div>

          <div class="mb-5">
            <div class="text-xs font-bold text-[#8B7355]/50 dark:text-[#B8A890]/50 uppercase tracking-widest mb-2">Pedido</div>
            <div class="code-block">
              <button class="copy-code-btn" type="button" onclick="copyCode(this, 'curl https://tofupass.com/api/stats')">Copiar</button>
              <pre>curl <span class="tok-url">https://tofupass.com/api/stats</span></pre>
            </div>
          </div>

          <div>
            <div class="flex items-center gap-2 mb-2">
              <div class="text-xs font-bold text-[#8B7355]/50 dark:text-[#B8A890]/50 uppercase tracking-widest">Resposta</div>
              <span class="status-200 text-xs px-2 py-0.5 rounded font-bold mono">200 OK</span>

          <div class="mb-5">
            <div class="text-xs font-bold text-[#8B7355]/50 dark:text-[#B8A890]/50 uppercase tracking-widest mb-2">Pedido</div>
            <div class="code-block">
              <button class="copy-code-btn" type="button" onclick="copyCode(this, 'curl https://tofupass.com/api/languages')">Copiar</button>
              <pre>curl <span class="tok-url">https://tofupass.com/api/languages</span></pre>

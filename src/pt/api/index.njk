          <div class="mb-5">
            <div class="text-xs font-bold text-[#8B7355]/50 dark:text-[#B8A890]/50 uppercase tracking-widest mb-2">Pedido</div>
            <div class="code-block">
              <button class="copy-code-btn" type="button" onclick="copyCode(this, 'curl https://tofupass.com/api/passphrase?count=4')">Copiar</button>
              <pre><span class="tok-comment">Predefinição, 4 palavras</span>
curl <span class="tok-url">https://tofupass.com/api/passphrase</span>

<span class="tok-comment"># Contagem personalizada de palavras e linguagem</span>
curl <span class="tok-url">https://tofupass.com/api/passphrase?count=6&amp;lang=fr</span>

<span class="tok-comment">Buscar JavaScript</span>
<span class="tok-key">const</span> res = <span class="tok-key">await</span> fetch(<span class="tok-str">'https://tofupass.com/api/passphrase?count=4'</span>);
<span class="tok-key">const</span> phrase = <span class="tok-key">await</span> res.text();</pre>
            </div>
          </div>

          <div>
            <div class="text-xs font-bold text-[#8B7355]/50 dark:text-[#B8A890]/50 uppercase tracking-widest mb-2">Respostas</div>
            <div class="space-y-3">
              <div>
                <div class="flex items-center gap-2 mb-1.5">
                  <span class="status-200 text-xs px-2 py-0.5 rounded font-bold mono">200 OK</span>
                  <span class="response-type">Content-Type: text/plain</span>

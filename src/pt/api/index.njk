                <div class="code-block">
                  <pre><span class="tok-str">too many requests; please try again later</span></pre>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- ENDPOINT 3: /api/languages -->
      <div class="endpoint-card mb-6 overflow-hidden">
        <div class="endpoint-head">
          <div class="endpoint-title">
            <span class="method-get text-xs font-bold px-3 py-1 rounded-lg mono tracking-wide">GET</span>

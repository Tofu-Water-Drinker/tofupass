      <!-- ENDPOINT 1: /api/password -->
      <div class="endpoint-card mb-6 overflow-hidden">
        <div class="endpoint-head">
          <div class="endpoint-title">
            <span class="method-get text-xs font-bold px-3 py-1 rounded-lg mono tracking-wide">GET</span>
            <span class="mono text-[#4A3728]/80 dark:text-[#F0E6D8]/80 font-semibold text-sm sm:text-base">/api/password</span>
          </div>
          <span class="endpoint-desc">Obter uma senha</span>
        </div>
        <div class="px-6 py-6">
          <p class="text-[#8B7355] dark:text-[#B8A890] text-sm mb-5 leading-relaxed">Retorna uma senha legível gerada no servidor. O formato atual da API é duas palavras amigáveis, um caractere especial e um número de dois dígitos, com maiúsculas e posição do símbolo aleatórias. Este endpoint é separado das receitas Soft, Firm e Extra Firm do gerador web.</p>

          <div class="mb-5">
            <div class="text-xs font-bold text-[#8B7355]/50 dark:text-[#B8A890]/50 uppercase tracking-widest mb-3">Parâmetros de Consulta</div>
            <div class="param-table">
              <div class="param-row param-head">
                <div>Nome</div>
                <div>Tipo</div>
                <div>Padrão</div>
                <div>Designação das mercadorias</div>
              </div>
              <div class="param-row">
                <div class="mono text-[#9B6DD7]">lang</div>
                <div>string</div>
                <div class="mono text-[#E6A800]">en</div>
                <div>Código de idioma opcional para palavras geradas</div>
              </div>
            </div>
          </div>

          <div class="mb-5">
            <div class="text-xs font-bold text-[#8B7355]/50 dark:text-[#B8A890]/50 uppercase tracking-widest mb-2">Pedido</div>
            <div class="code-block">
              <button class="copy-code-btn" type="button" onclick="copyCode(this, 'curl https://tofupass.com/api/password')">Copiar</button>
              <pre><span class="tok-comment"># Usando o cacho</span>
curl <span class="tok-url">https://tofupass.com/api/password</span>

<span class="tok-comment">Usando o JavaScript</span>
<span class="tok-key">const</span> res = <span class="tok-key">await</span> fetch(<span class="tok-str">'https://tofupass.com/api/password'</span>);
<span class="tok-key">const</span> password = <span class="tok-key">await</span> res.text();</pre>
            </div>
          </div>

          <div>
            <div class="text-xs font-bold text-[#8B7355]/50 dark:text-[#B8A890]/50 uppercase tracking-widest mb-2">Respostas</div>
            <div class="space-y-3">
              <div>
                <div class="flex items-center gap-2 mb-1.5">
                  <span class="status-200 text-xs px-2 py-0.5 rounded font-bold mono">200 OK</span>
                  <span class="response-type">Content-Type: text/plain</span>
                </div>
                <div class="code-block">
                  <pre><span class="tok-str">!HappyTiger83</span></pre>
                </div>
              </div>
              <div>
                <div class="flex items-center gap-2 mb-1.5">
                  <span class="status-429 text-xs px-2 py-0.5 rounded font-bold mono">429 Too Many Requests</span>
                  <span class="response-type">Includes Retry-After</span>
                </div>
                <div class="code-block">
                  <pre><span class="tok-str">too many requests; please slow down</span></pre>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- ENDPOINT 2: /api/passphrase -->
      <div class="endpoint-card mb-6 overflow-hidden">

eleventyExcludeFromCollections: true
permalink: /pt/index.html
---

  <div class="hero-band" aria-hidden="true"></div>

  <main class="relative z-10 pt-24 pb-16 px-4">
    <div class="max-w-5xl mx-auto text-center">
      <div class="hero-stage">
        <div class="generator-shell mb-6">
        <div class="generator-card p-6 sm:p-8 relative">
          <div class="flex flex-col items-center mb-5">
            <a href="/pt/miso/" class="mascot-wrap" aria-label="Conheça Miso">
              <img id="generatorMascot" src="/tofu.png" alt="Miso, o mascote do TofuPass" class="mascot-squish w-24 h-24 sm:w-28 sm:h-28 mascot-glow" />
              <span id="mascotSparks" class="mascot-sparks" aria-hidden="true">
                <span class="mascot-spark mascot-spark-1"></span>
                <span class="mascot-spark mascot-spark-2"></span>
                <span class="mascot-spark mascot-spark-3"></span>
                <span class="mascot-spark mascot-spark-4"></span>
              </span>
              <span id="mascotBubble" class="mascot-bubble" aria-live="polite" aria-atomic="true"></span>
            </a>
            <p class="mt-3 text-xs font-bold uppercase tracking-[0.2em] text-[#8B7355]/50 dark:text-[#B8A890]/50">Toca para generar &nbsp;&middot;&nbsp; clic para copiar</p>
          </div>

          <button type="button" onclick="copyPassword()" id="passwordPanel"
            class="password-panel w-full px-5 py-5 mb-5 min-h-[72px] flex flex-col items-center justify-center text-center">
            <p id="passwordDisplay" class="text-2xl sm:text-3xl font-bold text-center text-[#6BBF59] break-all leading-snug">
              Gerando...
            </p>
            <span id="passwordHint" class="password-hint mt-3 text-[11px] font-bold uppercase tracking-[0.22em]">Clique para copiar</span>
          </button>

          <div class="flex gap-3 flex-col sm:flex-row">
            <button id="generateBtn" onclick="generateNewPassword()"
              class="cta-btn flex-1 relative z-10 px-6 py-3 rounded-xl font-bold text-base text-white shadow-lg">
              Gerar nova senha
            </button>
            <button id="phoneticBtn" onclick="togglePhoneticGuide()" aria-expanded="false"
              class="flex-1 px-6 py-3 rounded-xl font-semibold text-sm transition-all">
              <span class="ui-icon phonetic-label-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path d="M4 6h6"></path>
                  <path d="M4 10h10"></path>
                  <path d="M4 14h7"></path>
                  <path d="M15 6l5 5-5 5"></path>
                </svg>
              </span>Guia fonético
            </button>
          </div>
        </div>
        </div>

        <div class="firmness-grid grid grid-cols-1 sm:grid-cols-3 gap-4 mb-4">
        <div class="level-card p-5 text-left" id="card-soft" onclick="selectLevel('soft')">
          <div class="ui-icon level-icon icon-soft" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <path d="M12 12c0-3-2-5-4-5-1.7 0-3 1.3-3 3 0 2 2 4 7 7"></path>
              <path d="M12 12c0-3 2-5 4-5 1.7 0 3 1.3 3 3 0 2-2 4-7 7"></path>
              <circle cx="12" cy="12" r="1.5"></circle>
            </svg>
          </div>
          <div class="text-xs font-extrabold tracking-widest text-[#FF7A7A] uppercase mb-1">Suave</div>
          <div class="font-extrabold text-[#4A3728] dark:text-[#F0E6D8] text-base mb-1">Simples e gentil</div>
          <p class="text-xs text-[#8B7355] dark:text-[#B8A890] leading-relaxed">2 palavras + símbolo + número<br/>ex. <span class="text-[#4A3728] dark:text-[#F0E6D8] font-mono font-bold">FelizGato!73</span></p>
        </div>

        <div class="level-card p-5 text-left active-firm" id="card-firm" onclick="selectLevel('firm')">
          <div class="ui-icon level-icon icon-firm" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <path d="M12 3l7 3v5c0 5-3.2 8.4-7 10-3.8-1.6-7-5-7-10V6l7-3z"></path>
            </svg>
          </div>
          <div class="flex items-center gap-2 mb-1">
            <div class="text-xs font-extrabold tracking-widest text-[#6BBF59] uppercase">Firme</div>
            <span class="text-xs text-[#6BBF59] font-bold">Recomendado</span>
          </div>
          <div class="font-extrabold text-[#4A3728] dark:text-[#F0E6D8] text-base mb-1">Fuerte y usable</div>
          <p class="text-xs text-[#8B7355] dark:text-[#B8A890] leading-relaxed">3 palavras + símbolo + número<br/>ex. <span class="text-[#4A3728] dark:text-[#F0E6D8] font-mono font-bold">DançandoGatoRio!73</span></p>
        </div>

        <div class="level-card p-5 text-left" id="card-extra" onclick="selectLevel('extra')">
          <div class="ui-icon level-icon icon-extra" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <rect x="4" y="5" width="16" height="4" rx="1.5"></rect>
              <rect x="4" y="10" width="16" height="4" rx="1.5"></rect>
              <rect x="4" y="15" width="16" height="4" rx="1.5"></rect>
            </svg>
          </div>
          <div class="text-xs font-extrabold tracking-widest text-[#E6A800] uppercase mb-1">Extra firme</div>
          <div class="font-extrabold text-[#4A3728] dark:text-[#F0E6D8] text-base mb-1">Mais entropia</div>
          <p class="text-xs text-[#8B7355] dark:text-[#B8A890] leading-relaxed">4 palavras + símbolo + número<br/>ex. <span class="text-[#4A3728] dark:text-[#F0E6D8] font-mono font-bold">DançandoGatoBrilhanteRio!73</span></p>
        </div>
        </div>

        <p class="text-xs text-[#8B7355]/60 dark:text-[#B8A890]/60 mt-3 font-semibold">Hecho para el punto medio entre seguridad y facilidad de uso. Todo se genera en tu dispositivo.</p>

        <a href="#por-que-tofupass" class="scroll-cue" aria-label="Bajar para saber más">
          <span class="scroll-cue-icon ui-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <path d="M12 5v14"></path>
              <path d="m6 13 6 6 6-6"></path>
            </svg>
          </span>
        </a>
      </div>
    </div>
  </main>

  <section id="por-que-tofupass" class="relative z-10 pt-16 pb-20 px-4">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-black mb-3 text-[#4A3728] dark:text-[#F0E6D8]">O que torna o <span class="brand-wordmark">Tofu<span class="brand-wordmark-accent">Pass</span></span> diferente?</h2>
        <p class="text-[#8B7355] dark:text-[#B8A890] text-base max-w-2xl mx-auto font-medium">Um gerador pensado para uso real: palavras memoráveis, aleatoriedade confiável e nada saindo do seu navegador.</p>
      </div>
      <div class="features-open grid grid-cols-1 md:grid-cols-3 gap-12 md:gap-10">
        <div class="feature-open text-center">
          <div class="feature-dot feature-dot-violet mx-auto mb-5" aria-hidden="true">
            <svg viewBox="0 0 24 24" class="w-6 h-6">
              <rect x="5" y="11" width="14" height="10" rx="2" stroke="currentColor" fill="none" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"></rect>
              <path d="M8 11V8a4 4 0 1 1 8 0v3" stroke="currentColor" fill="none" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </div>
          <h3 class="text-lg font-extrabold mb-2 text-[#4A3728] dark:text-[#F0E6D8]">Segurança sem teatro</h3>
          <p class="text-[#8B7355] dark:text-[#B8A890] text-sm leading-relaxed">Usa <code class="text-[#6BBF59] font-mono text-xs font-bold">crypto.getRandomValues()</code> del navegador para generar aleatoriedad real.</p>
        </div>

        <div class="feature-open text-center">
          <div class="feature-dot feature-dot-green mx-auto mb-5" aria-hidden="true">
            <svg viewBox="0 0 24 24" class="w-6 h-6">
              <path d="M12 3l7 3v5c0 5-3.2 8.4-7 10-3.8-1.6-7-5-7-10V6l7-3z" stroke="currentColor" fill="none" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </div>
          <h3 class="text-lg font-extrabold mb-2 text-[#4A3728] dark:text-[#F0E6D8]">Projetado para pessoas</h3>
          <p class="text-[#8B7355] dark:text-[#B8A890] text-sm leading-relaxed">Senhas com palavras são mais fáceis de digitar e lembrar, reduzindo reutilização, simplificações e notas coladas.</p>
        </div>

        <div class="feature-open text-center">
          <div class="feature-dot feature-dot-yellow mx-auto mb-5" aria-hidden="true">
            <svg viewBox="0 0 24 24" class="w-6 h-6">
              <path d="M6 8.5c0-1.4 1.1-2.5 2.5-2.5h7c1.4 0 2.5 1.1 2.5 2.5v7c0 1.4-1.1 2.5-2.5 2.5h-7C7.1 18 6 16.9 6 15.5z" stroke="currentColor" fill="none" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"></path>
              <path d="M9 10h6" stroke="currentColor" fill="none" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"></path>
              <path d="M9 14h4" stroke="currentColor" fill="none" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </div>
          <h3 class="text-lg font-extrabold mb-2 text-[#4A3728] dark:text-[#F0E6D8]">Padrões claros</h3>
          <p class="text-[#8B7355] dark:text-[#B8A890] text-sm leading-relaxed">Suave, Firme e Extra firme mantêm palavras com maiúscula, um símbolo comum e um número curto.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="relative z-10 pb-24 px-4">
    <div class="max-w-2xl mx-auto text-center">
      <div class="flex justify-center mb-12">
        <svg class="w-48 h-4 text-[#8BC34A]/20" viewBox="0 0 200 16" fill="none" aria-hidden="true">
          <path d="M0 8 C 25 0, 50 16, 75 8 S 125 0, 150 8 S 175 16, 200 8" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
        </svg>
      </div>

      <img src="/excited.png" alt="Miso animado" class="w-20 h-20 mx-auto mb-6 mascot-glow" style="animation: mascotIdle 3s ease-in-out infinite;" />
      <h2 class="text-2xl sm:text-3xl font-black mb-3 text-[#4A3728] dark:text-[#F0E6D8]">Já tem uma senha?</h2>
      <p class="text-[#8B7355] dark:text-[#B8A890] text-sm mb-8 max-w-md mx-auto font-medium leading-relaxed">Veja quanto tempo levaria para quebrá-la e se ela aparece em vazamentos conhecidos.</p>
      <a href="/pt/stresstest/" class="inline-block cta-btn relative z-10 px-8 py-4 rounded-2xl font-bold text-base text-white shadow-xl mb-6">
        Abrir teste
      </a>
      <p class="text-[#8B7355]/60 dark:text-[#B8A890]/60 text-sm font-semibold">
        Prefere frases longas? <a href="/pt/passphrases/" class="text-[#6BBF59] dark:text-[#7DD668] hover:text-[#4A9F3F] underline underline-offset-2 decoration-[#6BBF59]/30 hover:decoration-[#6BBF59] transition-colors font-bold">Abra o gerador de frases</a>
      </p>
    </div>
  </section>

  <div id="phoneticBackdrop" class="phonetic-backdrop" onclick="closePhoneticGuide()"></div>
  <aside id="phoneticDrawer" class="phonetic-sheet" aria-labelledby="phoneticTitle" aria-hidden="true">
    <div class="phonetic-sheet-head">
      <div class="flex items-center justify-between mb-3">
        <span id="phoneticTitle" class="text-sm font-extrabold uppercase tracking-[0.12em] text-[#4A3728] dark:text-[#F0E6D8]">Guia fonético</span>
        <button onclick="closePhoneticGuide()" data-close class="phonetic-close" aria-label="Fechar guia fonético">&times;</button>
      </div>
      <div id="phoneticPasswordEcho" class="phonetic-pw-echo font-mono text-lg font-bold text-[#6BBF59] break-all text-center mb-3"></div>
      <div class="flex gap-2">
        <button id="tabMilitary" class="tab-btn active" onclick="setPhoneticMode('military')" aria-selected="true" aria-label="Guia fonético NATO">
          <span class="ui-icon phonetic-label-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <path d="M5 11a7 7 0 0 1 14 0"></path>
              <path d="M7 11v2a5 5 0 0 0 10 0v-2"></path>
              <path d="M4 11h16"></path>
            </svg>
          </span>NATO
        </button>
        <button id="tabKid" class="tab-btn" onclick="setPhoneticMode('kid')" aria-selected="false" aria-label="Guia fonético amigable">
          <span class="ui-icon phonetic-label-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <circle cx="12" cy="8" r="3"></circle>
              <path d="M7 19a5 5 0 0 1 10 0"></path>
            </svg>
          </span>Amigable
        </button>
      </div>
    </div>
    <div class="phonetic-sheet-body">
      <div id="phoneticList"></div>
    </div>
  </aside>

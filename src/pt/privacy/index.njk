        <p class="text-[#8B7355]/50 dark:text-[#B8A890]/50 text-sm">Última atualização: 23 de março de 2026</p>
      </div>

      <!-- Commitment banner -->
      <div class="mb-8 rounded-2xl p-6 border-2 border-[#6BBF59]/20" style="background: rgba(107,191,89,0.05);">

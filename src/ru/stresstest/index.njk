---
layout: base.njk
title: Тестер стресса - TofuPass
pageKey: stresstest
extraCss:
- /assets/css/stresstest.css
pageScripts:
- /assets/js/stresstest-ru.js
- /assets/js/stresstest.js
backgroundDecor: leaves
lang: ru
---


  <!-- CONTENT -->
  <main id="main-content" class="relative z-10 pt-28 pb-20 px-4">
    <div class="max-w-xl mx-auto">

      <!-- Header -->
      <div class="text-center mb-10">
        <h1 class="text-4xl sm:text-5xl font-black mb-4 text-[#4A3728] dark:text-[#F0E6D8]"><span class="gradient-text">Стресс</span> экзаменатор</h1>
        <p class="text-[#8B7355] dark:text-[#B8A890] text-base max-w-sm mx-auto">Сколько времени потребуется компьютеру, чтобы взломать пароль? И она уже просочилась?</p>
      </div>

      <!-- MAIN CARD -->
      <div class="main-card glass rounded-3xl p-6 sm:p-8 mb-6">

        <!-- Password Input -->
        <div class="mb-6">
          <label for="password" class="block text-xs font-bold text-[#8B7355] dark:text-[#B8A890] uppercase tracking-widest mb-2">Ваш пароль</label>
          <input
            id="password"
            type="password"
            placeholder="Введите пароль для анализа..."
            autocomplete="off"
            autocorrect="off"
            autocapitalize="off"
            spellcheck="false"
            class="pw-input"
            aria-describedby="passwordHelp char-count"
          />
          <p id="passwordHelp" class="stress-helper">Анализ выполняется в вашем браузере. TofuPass не получает этот пароль.</p>
          <div class="flex items-center justify-between mt-2">
            <button type="button" onclick="toggleVisibility()" id="visBtn" aria-pressed="false" aria-controls="password"
              class="text-xs text-[#8B7355]/50 dark:text-[#B8A890]/50 hover:text-[#4A3728] dark:hover:text-[#F0E6D8] transition-colors flex items-center gap-1">
              <span id="visIcon" aria-hidden="true">👁</span> <span id="visText">Показать</span>
            </button>
            <div id="char-count" class="text-xs text-[#8B7355]/40 dark:text-[#B8A890]/40" aria-live="polite" aria-atomic="true"></div>
          </div>
        </div>

        <!-- Strength Meter -->
        <div class="mb-6">
          <div class="flex items-center justify-between mb-2">
            <span id="strengthText" class="text-xs font-bold text-[#8B7355] dark:text-[#B8A890] uppercase tracking-widest">Сила</span>
            <span id="strength-label" class="strength-label text-[#8B7355]/50 dark:text-[#B8A890]/50 bg-[#6BBF59]/5 dark:bg-[#7DD668]/10">Ждать</span>
          </div>
          <div class="meter-track" role="meter" aria-labelledby="strengthText" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-valuetext="Ожидание">
            <div id="meter-fill"></div>
          </div>
        </div>

        <!-- Hardware Select -->
        <div class="mb-6">
          <div class="flex items-center gap-2 mb-2">
            <label class="text-xs font-bold text-[#8B7355] dark:text-[#B8A890] uppercase tracking-widest" for="hardware">Оборудование Attacker</label>
            <div class="tooltip-wrap">
              <button type="button" class="tooltip-toggle" aria-expanded="false" aria-controls="hardwareHelp" aria-label="Открыть объяснение атакующего оборудования">?</button>
              <div id="hardwareHelp" class="tooltip-content" hidden>
                <strong class="text-[#4A3728] dark:text-[#F0E6D8]">Скорость атаки</strong> Это показывает, сколько паролей в секунду может сделать аппаратное обеспечение. Современные графические процессоры могут тестировать миллиарды хешей в секунду на автономных базах данных.
              </div>
            </div>
          </div>
          <select id="hardware" class="hw-select">
            <option value="1e9">Потребительский GPU (1 млрд/сек)</option>
            <option value="1e10">Высокопроизводительный игровой ПК (10 млрд/сек)</option>
            <option value="1e12">Ботнет/облачный кластер (1 трлн/сек)</option>
            <option value="1e14">Nation-State Hardware (100 трлн/сек)</option>
          </select>
        </div>

        <!-- Time Display -->
        <div class="mb-6 text-center py-6 border-y-2 border-[#6BBF59]/8 dark:border-[#7DD668]/12">
          <div class="text-xs font-bold text-[#8B7355]/50 dark:text-[#B8A890]/50 uppercase tracking-widest mb-3">Расчетное время Crack</div>
          <div id="time-display">Пока нет.</div>
          <div id="scanning-text" class="text-xs text-[#8B7355]/40 dark:text-[#B8A890]/40 mt-2 h-4"></div>
        </div>

        <!-- Breach Alert -->
        <div id="breach-card">
          <div class="flex items-start gap-3">
            <div class="text-2xl">🚨</div>
            <div>
              <div class="font-bold text-[#FF7A7A] text-sm mb-1">Найдено в нарушениях данных</div>
              <p id="breach-text" class="text-[#4A3728]/70 dark:text-[#F0E6D8]/70 text-sm leading-relaxed"></p>
              <p class="text-[#8B7355]/50 dark:text-[#B8A890]/50 text-xs mt-2">Немедленно прекратите использовать этот пароль. Создайте новый выше.</p>
            </div>
          </div>
        </div>

      </div>

      <!-- How it works / Privacy note -->
      <div class="glass rounded-2xl p-5 mb-6">
        <div class="flex items-start gap-3">
          <div class="text-xl mt-0.5">
            <div class="tooltip-wrap">
              <button type="button" class="tooltip-toggle tooltip-key" aria-expanded="false" aria-controls="breachHelp" aria-label="Открыть объяснение проверки утечек">🔑</button>
              <div id="breachHelp" class="tooltip-content" style="left: 0; transform: none;" hidden>
                <strong class="text-[#4A3728] dark:text-[#F0E6D8]">k-анонимность</strong>Только первые 5 символов хэша SHA-1 вашего пароля отправляются на Have I Been Pwned. Полный хэш и фактический пароль никогда не покидают устройство. API возвращает все хэши с этим префиксом, и сопоставление выполняется локально.
              </div>
            </div>
          </div>
          <div>
            <div class="font-semibold text-[#4A3728] dark:text-[#F0E6D8] text-sm mb-1">Проверка утечек с сохранением приватности</div>
            <p class="text-[#8B7355] dark:text-[#B8A890] text-xs leading-relaxed">Использование обнаружения нарушений <strong class="text-[#4A3728] dark:text-[#F0E6D8]">k-анонимность</strong> Скачать Have I Been Pwned Ваш фактический пароль никогда не передается. Отправляется только хеш-приставка из 5 символов. Нажмите на ключевую иконку, чтобы узнать больше.</p>
          </div>
        </div>
      </div>
      <div id="stressStatus" class="sr-only" aria-live="polite" aria-atomic="true"></div>

      <!-- Stats Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <div class="stat-box">
          <div class="text-lg font-black text-[#4A3728] dark:text-[#F0E6D8]" id="stat-length">0</div>
          <div class="text-xs text-[#8B7355]/60 dark:text-[#B8A890]/60 mt-1">Персонажи</div>
        </div>
        <div class="stat-box">
          <div class="text-lg font-black text-[#4A3728] dark:text-[#F0E6D8]" id="stat-pool">0</div>
          <div class="text-xs text-[#8B7355]/60 dark:text-[#B8A890]/60 mt-1">Размер бассейна</div>
        </div>
        <div class="stat-box">
          <div class="text-lg font-black text-[#4A3728] dark:text-[#F0E6D8]" id="stat-entropy">0</div>
          <div class="text-xs text-[#8B7355]/60 dark:text-[#B8A890]/60 mt-1">Биты энтропии</div>
        </div>
      </div>

    </div>
  </main>
